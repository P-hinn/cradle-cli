node_modules/
dist/
.cradle/
*.tsbuildinfo

# Yarn Berry's install state is a binary cache, not something to review.
test/fixtures/**/.yarn/install-state.gz

# Fixtures normally ship package.json and a lockfile only. pnpm and Yarn keep no
# licence data in their lockfiles, though, so those fixtures also carry a
# committed node_modules tree of nothing but package.json manifests - no code.
# That keeps the tests offline and deterministic without an install step.
# Both negations are needed: the first re-includes the directory, the second its
# contents, including the nested node_modules pnpm creates under .pnpm.
!test/fixtures/pnpm-basic/node_modules/
!test/fixtures/pnpm-basic/node_modules/**
!test/fixtures/yarn-classic-basic/node_modules/
!test/fixtures/yarn-classic-basic/node_modules/**
!test/fixtures/yarn-berry-basic/node_modules/
!test/fixtures/yarn-berry-basic/node_modules/**
