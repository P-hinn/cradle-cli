{
  "name": "cradle-cli",
  "version": "0.1.0",
  "description": "SBOM, vulnerability findings and a CRA readiness report for npm projects — one command.",
  "keywords": [
    "sbom",
    "cyclonedx",
    "cra",
    "cyber-resilience-act",
    "compliance",
    "vulnerability",
    "osv",
    "vex",
    "openvex",
    "npm",
    "pnpm",
    "yarn",
    "supply-chain",
    "security"
  ],
  "homepage": "https://github.com/P-hinn/cradle-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P-hinn/cradle-cli.git"
  },
  "bugs": {
    "url": "https://github.com/P-hinn/cradle-cli/issues"
  },
  "author": "Philipp Niestroj",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "bin": {
    "cradle": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prebuild": "node scripts/gen-version.mjs",
    "generate": "node scripts/gen-spdx-ids.mjs && node scripts/gen-version.mjs && node scripts/gen-demo-svg.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "packageurl-js": "^2.0.1",
    "semver": "^7.8.5",
    "spdx-expression-parse": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.0",
    "@types/semver": "^7.8.0",
    "@types/spdx-expression-parse": "^4.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
