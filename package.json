{
  "name": "cradle-cli",
  "version": "0.0.0",
  "description": "SBOM, vulnerability findings and a CRA readiness report for npm projects — one command.",
  "keywords": [
    "sbom",
    "cyclonedx",
    "cra",
    "cyber-resilience-act",
    "npm",
    "vex",
    "openvex",
    "osv"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "bin": {
    "cradle": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "SPEC.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@npmcli/arborist": "^9.9.1",
    "packageurl-js": "^2.0.1",
    "spdx-expression-parse": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^24.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
